# ScamShield Backend Environment Configuration
# Copy this file to .env and fill in your actual credentials

# Google Gemini API Key (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key
# Gemini response read timeout; increase for slow provider responses (5-120 seconds).
GEMINI_READ_TIMEOUT_SECONDS=60

# Sarvam AI API Key (https://www.sarvam.ai/)
SARVAM_API_KEY=your_sarvam_api_key

# Telegram Bot Configuration (https://core.telegram.org/bots#creating-a-new-bot)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id
# Send family alerts for analyses at or above this risk score (0-100).
TELEGRAM_ALERT_THRESHOLD=80

# Database URL
DATABASE_URL=sqlite:///./scamshield.db

# Debug mode (set to false in production)
DEBUG=true

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:8000,http://localhost:5000
